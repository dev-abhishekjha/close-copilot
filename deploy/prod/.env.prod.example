# Production values for deploy/prod/docker-compose.yml. Copy to
# deploy/prod/.env.prod on the VM (git-ignored) and replace every CHANGE_ME.
# Generate each secret fresh: openssl rand -hex 32
# Never reuse a value from your local .env.

# Public host name; DNS must point at the VM before caddy can get a certificate
DEMO_DOMAIN=demo.example.com

# --- Postgres -----------------------------------------------------------------
# openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME

# --- ERPNext ------------------------------------------------------------------
ERP_SITE=erp.localhost
# copilot-bot keys (read only): deploy/erpnext/api-users.sh
ERP_API_KEY=CHANGE_ME
ERP_API_SECRET=CHANGE_ME
# copilot-poster keys; given to mcp-books only, never equal to the bot's keys
ERP_POST_API_KEY=CHANGE_ME
ERP_POST_API_SECRET=CHANGE_ME

# --- MCP servers --------------------------------------------------------------
# openssl rand -hex 32 for each
MCP_TOKEN_AGENT=CHANGE_ME
MCP_TOKEN_ADMIN=CHANGE_ME
MCP_SCOPE_KEY=CHANGE_ME

# --- LLM ----------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=CHANGE_ME
# Full model IDs (check Anthropic's models page)
LLM_MODEL_FAST=CHANGE_ME
LLM_MODEL_STRONG=CHANGE_ME
# Keep low: the public demo's daily spend cap. Also set a spend limit in the
# Anthropic console.
LLM_DAILY_BUDGET_USD=2.00
LLM_RUN_TOKEN_CAP=200000
# openssl rand -hex 32
PSEUDONYM_KEY=CHANGE_ME

# --- Tracing (Langfuse Cloud) -------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Authorization=Basic <base64(public_key:secret_key)>
OTEL_EXPORTER_OTLP_HEADERS=CHANGE_ME

# --- Web app ------------------------------------------------------------------
# At least 32 bytes: openssl rand -hex 32
APP_SESSION_KEY=CHANGE_ME

# TEI image tag; use cpu-arm64-1.9 on an ARM VM
TEI_IMAGE_TAG=cpu-1.9
