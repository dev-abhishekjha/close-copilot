package templates

// RunFindings is the findings list of one run, with type and status filters.
templ RunFindings(p FindingsPage) {
	@Base(Layout{Title: "Findings", User: p.User, Role: p.Role, CSRFToken: p.CSRFToken}) {
		@PageHeader(PageHeaderProps{Title: "Findings: " + runTitle(p.Company, p.Month), Actions: findingsActions(p)})
		<form method="get" action={ templ.SafeURL(findingsURL(p.RunID)) } class="filters">
			@SelectField(FieldProps{ID: "type", Name: "type", Label: "Type", Value: p.SelType, Options: filterOptions(p.Types)})
			@SelectField(FieldProps{ID: "status", Name: "status", Label: "Status", Value: p.SelStatus, Options: filterOptions(p.Statuses)})
			@Button(ButtonProps{Label: "Filter", Type: "submit", Variant: "secondary", Icon: "filter"})
		</form>
		if len(p.Rows) == 0 {
			@EmptyState(EmptyProps{Icon: "search", Title: "No findings match", Body: "Change the filters or start another close."})
		} else {
			<div class="findings-table">
				@DataTable(TableProps{Caption: "Findings", Columns: findingColumns, Rows: findingTableRows(p.Rows)})
			</div>
		}
	}
}

templ findingsActions(p FindingsPage) {
	@Button(ButtonProps{Label: "All runs", Href: "/runs", Variant: "ghost"})
	@Button(ButtonProps{Label: "Run status", Href: runURL(p.RunID), Variant: "secondary"})
}
