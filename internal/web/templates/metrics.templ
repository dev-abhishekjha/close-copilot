package templates

// Metrics is the run metrics page: tokens by step, cost, duration, verified
// rate and the trace ID.
templ Metrics(p MetricsPage) {
	@Base(Layout{Title: "Run metrics", User: p.User, Role: p.Role, CSRFToken: p.CSRFToken}) {
		<div id="metrics" class="metrics-page">
			@PageHeader(PageHeaderProps{Title: "Run metrics: " + p.Company + " " + p.Month, Actions: metricsLinks(p.RunID)})
			<div class="metrics-tiles">
				<div class="ui-stat">
					<span class="ui-stat-label">Status</span>
					<span class="ui-stat-value metrics-status">
						@StatusChip(p.Status)
					</span>
				</div>
				@StatTile(StatProps{Label: "Duration", Value: p.Duration})
				@StatTile(StatProps{Label: "Cost", Value: p.Cost})
				@StatTile(StatProps{Label: "Verified rate", Value: p.VerifiedRate})
				@StatTile(StatProps{Label: "Tokens in", Value: i64(p.Input)})
				@StatTile(StatProps{Label: "Tokens out", Value: i64(p.Output)})
				@StatTile(StatProps{Label: "Cache read", Value: i64(p.Cache)})
			</div>
			<p class="metrics-trace">
				Trace:
				if p.TraceID == "" {
					none
				} else {
					<code>{ p.TraceID }</code>
				}
			</p>
			@Card(CardProps{Title: "Usage by step"}) {
				@DataTable(TableProps{Caption: "Usage by step", Columns: stepColumns(), Rows: stepRows(p.Steps), EmptyTitle: "No model calls recorded.", Dense: true})
			}
			if len(p.Steps) > 0 {
				<div class="metrics-charts">
					@Card(CardProps{Title: "Tokens by step"}) {
						@BarChart(p.TokenChart)
					}
					@Card(CardProps{Title: "Cost by step"}) {
						@BarChart(p.CostChart)
					}
				</div>
			}
			if p.Trend != nil {
				@Card(CardProps{ID: "recent-runs", Title: "Recent runs", Subtitle: "Last finished runs of any company, newest on the right."}) {
					<div class="metrics-charts">
						@LineChart(p.Trend.Cost)
						@LineChart(p.Trend.Verified)
					</div>
				}
			}
		</div>
	}
}

templ metricsLinks(runID string) {
	<nav class="metrics-links" aria-label="Related">
		<a href="/runs">All runs</a>
		<a href={ templ.SafeURL(runURL(runID)) }>Run</a>
		<a href={ templ.SafeURL(findingsURL(runID)) }>Findings</a>
	</nav>
}
