package templates


// Runs is the runs page: a start card for makers, a summary and the past runs.
templ Runs(p RunsPage) {
	@Base(Layout{Title: "Close runs", User: p.User, Role: p.Role, CSRFToken: p.CSRFToken}) {
		@PageHeader(PageHeaderProps{Title: "Close runs"})
		if p.Error != "" {
			<p class="error runs-alert" role="alert">{ p.Error }</p>
		}
		if p.CanStart {
			@Card(CardProps{ID: "start-close", Title: "Start a close"}) {
				@startForm(p)
			}
		}
		if p.ShowSummary {
			@runsSummary(p.Summary)
		}
		if len(p.Runs) == 0 {
			@EmptyState(EmptyProps{Icon: "play", Title: "No runs yet", Body: emptyRunsBody(p.CanStart)})
		} else {
			<div class="runs-table">
				@DataTable(TableProps{Caption: "Close runs", Columns: runColumns, Rows: runRows(p.Runs)})
			</div>
		}
	}
}

func emptyRunsBody(canStart bool) string {
	if canStart {
		return "Pick a company and month above to start the first close."
	}
	return "A maker can start a close from this page."
}

templ startForm(p RunsPage) {
	<form method="post" action="/runs" class="start-run">
		<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
		@SelectField(FieldProps{ID: "company", Name: "company", Label: "Company", Value: p.Company, Options: companyOptions(p.Companies)})
		<div class="ui-field">
			<label class="ui-label" for="month">Month <span class="ui-req" aria-hidden="true">*</span></label>
			<input class="ui-input" id="month" name="month" value={ p.Month } type="month" placeholder="YYYY-MM" pattern={ monthPattern } required/>
		</div>
		@Button(ButtonProps{Label: "Start close", Type: "submit", Icon: "play"})
	</form>
}

templ runsSummary(s *SummaryCard) {
	<div class="runs-stats" id="runs-summary">
		if s == nil {
			<p class="runs-muted">No finished runs yet.</p>
		} else {
			<div class="ui-stat runs-stat">
				<span class="ui-stat-label">Last finished run</span>
				<span class="ui-stat-value runs-stat-text"><a class="summary-run" href={ templ.SafeURL(runURL(s.RunID)) }>{ s.Company } { s.Month }</a></span>
			</div>
			<div class="ui-stat runs-stat">
				<span class="ui-stat-label">Verified rate</span>
				<span class="ui-stat-value runs-stat-text"><a class="summary-verified" href={ templ.SafeURL(metricsURL(s.RunID)) }>{ s.VerifiedRate }</a></span>
			</div>
			<div class="ui-stat runs-stat">
				<span class="ui-stat-label">Open high-severity findings</span>
				<span class="ui-stat-value runs-stat-text"><a class="summary-high" href={ templ.SafeURL(findingsURL(s.RunID)) }>{ itoa(s.OpenHigh) }</a></span>
			</div>
		}
	</div>
}
