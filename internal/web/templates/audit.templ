package templates

// Audit is the checker's audit log: who did what, newest first. Arguments
// are untrusted JSON and render as text only.
templ Audit(p AuditPage) {
	@Base(Layout{Title: "Audit log", User: p.User, Role: p.Role, CSRFToken: p.CSRFToken}) {
		<section class="card" id="audit">
			<h1>Audit log</h1>
			<form method="get" action="/audit" class="filters">
				<label>
					Actor
					<select name="actor">
						<option value="">any</option>
						for _, a := range p.Actors {
							<option value={ a } selected?={ a == p.SelActor }>{ a }</option>
						}
					</select>
				</label>
				<label>
					Server
					<select name="server">
						<option value="">any</option>
						for _, a := range p.Servers {
							<option value={ a } selected?={ a == p.SelServer }>{ a }</option>
						}
					</select>
				</label>
				<label>
					Tool
					<select name="tool">
						<option value="">any</option>
						for _, a := range p.Tools {
							<option value={ a } selected?={ a == p.SelTool }>{ a }</option>
						}
					</select>
				</label>
				<label>
					From
					<input type="text" name="from" value={ p.From } placeholder="YYYY-MM-DD"/>
				</label>
				<label>
					To
					<input type="text" name="to" value={ p.To } placeholder="YYYY-MM-DD"/>
				</label>
				<button type="submit">Filter</button>
			</form>
			if len(p.Rows) == 0 {
				<p>No audit entries match.</p>
			} else {
				<table class="audit">
					<thead>
						<tr>
							<th>Time (UTC)</th>
							<th>Actor</th>
							<th>Server</th>
							<th>Tool</th>
							<th>Arguments</th>
							<th>Rows</th>
							<th>Latency (ms)</th>
							<th>Error</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range p.Rows {
							<tr class="audit-row">
								<td class="time">{ r.Time }</td>
								<td class="actor">{ r.Actor }</td>
								<td class="server">{ r.Server }</td>
								<td class="tool">{ r.Tool }</td>
								<td class="args">
									<code>{ r.ArgsShort }</code>
									if r.Truncated {
										<details>
											<summary>full</summary>
											<code>{ r.ArgsFull }</code>
										</details>
									}
								</td>
								<td class="count">{ r.ResultCount }</td>
								<td class="latency">{ r.Latency }</td>
								<td class="error">{ r.Error }</td>
							</tr>
						}
					</tbody>
				</table>
			}
			if p.OlderURL != "" {
				<p><a class="older" href={ templ.SafeURL(p.OlderURL) }>Older</a></p>
			}
		</section>
	}
}
