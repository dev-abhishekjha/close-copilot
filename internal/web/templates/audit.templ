package templates

// Audit is the checker's audit log: who did what, newest first. Arguments
// are untrusted JSON and render as text only.
templ Audit(p AuditPage) {
	@Base(Layout{Title: "Audit log", User: p.User, Role: p.Role, CSRFToken: p.CSRFToken}) {
		<div id="audit" class="audit-page">
			@PageHeader(PageHeaderProps{Title: "Audit log", Subtitle: "Every tool call and decision, newest first.", Actions: auditActions(p.ExportURL)})
			@Card(CardProps{Title: "Filters"}) {
				<form method="get" action="/audit" class="audit-filters">
					@SelectField(FieldProps{ID: "audit-actor", Name: "actor", Label: "Actor", Value: p.SelActor, Options: filterOptions(p.Actors)})
					@SelectField(FieldProps{ID: "audit-server", Name: "server", Label: "Server", Value: p.SelServer, Options: filterOptions(p.Servers)})
					@SelectField(FieldProps{ID: "audit-tool", Name: "tool", Label: "Tool", Value: p.SelTool, Options: filterOptions(p.Tools)})
					@Field(FieldProps{ID: "audit-from", Name: "from", Label: "From", Value: p.From, Placeholder: "YYYY-MM-DD", Attrs: map[string]any{"pattern": datePattern}})
					@Field(FieldProps{ID: "audit-to", Name: "to", Label: "To", Value: p.To, Placeholder: "YYYY-MM-DD", Attrs: map[string]any{"pattern": datePattern}})
					@Button(ButtonProps{Label: "Filter", Type: "submit", Icon: "filter"})
				</form>
				if len(p.Chips) > 0 {
					<ul class="audit-chips" aria-label="Active filters">
						for _, c := range p.Chips {
							<li>
								<a class="audit-chip" href={ templ.SafeURL(c.RemoveURL) }>
									<span>{ c.Label }: { c.Value }</span>
									<span aria-hidden="true">×</span>
									<span class="visually-hidden">remove filter</span>
								</a>
							</li>
						}
						<li><a class="audit-clear" href={ templ.SafeURL(p.ClearURL) }>Clear all</a></li>
					</ul>
				}
			}
			<div class="audit-table">
				@DataTable(TableProps{
					Caption: "Audit log", Columns: auditColumns(), Rows: auditRows(p.Rows), Dense: true,
					EmptyTitle: "No audit entries match.", EmptyBody: "Try a wider date range or clear the filters.",
				})
			</div>
			if p.OlderURL != "" {
				<p><a class="older" href={ templ.SafeURL(p.OlderURL) }>Older</a></p>
			}
		</div>
	}
}

templ auditActions(exportURL string) {
	@Button(ButtonProps{Label: "Export CSV", Variant: "secondary", Icon: "download", Href: exportURL})
}

templ auditArgs(r AuditRow) {
	<code>{ r.ArgsShort }</code>
	if r.Truncated {
		<details>
			<summary>full</summary>
			<code>{ r.ArgsFull }</code>
		</details>
	}
}
