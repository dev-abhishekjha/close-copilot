package templates

// Finding is the finding detail page.
templ Finding(p FindingPage) {
	@Base(Layout{Title: "Finding", User: p.User, Role: p.Role, CSRFToken: p.CSRFToken}) {
		<section id="header" class="finding-header" data-severity={ p.Severity }>
			@PageHeader(PageHeaderProps{
				Title:    p.Title,
				Subtitle: p.Company + " " + p.Month,
				Actions:  backLink(p),
			})
			@Facts(findingFacts(p))
		</section>
		if p.Review != nil {
			@Card(CardProps{ID: "review", Title: "Needs review", Tone: "warn"}) {
				if len(p.Review.Reasons) == 0 {
					<p>{ p.Review.Fallback }</p>
				} else {
					<ul>
						for _, r := range p.Review.Reasons {
							<li>{ r }</li>
						}
					</ul>
				}
			}
		}
		@Card(CardProps{ID: "explanation", Title: "Explanation"}) {
			if p.HasExplanation {
				<p class="explanation">{ p.Explanation }</p>
				<p class="action finding-action"><strong>Suggested action:</strong> { p.Action }</p>
			} else {
				<p class="finding-none">no explanation yet</p>
			}
		}
		@Card(CardProps{ID: "citations", Title: "Citations"}) {
			if len(p.Citations) == 0 {
				<p class="finding-none">No citations.</p>
			}
			for _, c := range p.Citations {
				<details>
					<summary>{ c.DocID }, { c.Section }</summary>
					<p>{ c.DocID } · { c.Section }</p>
					<p>snippet not stored on the finding</p>
				</details>
			}
		}
		<div class="finding-grid">
			<div class="finding-col">
				@Card(CardProps{ID: "evidence", Title: "Evidence"}) {
					if len(p.Evidence) == 0 {
						<p class="finding-none">No evidence recorded.</p>
					}
					for _, b := range p.Evidence {
						@evidenceBlock(b)
					}
				}
			</div>
			<div class="finding-col">
				if p.Proposal != nil {
					@Card(CardProps{ID: "proposal", Title: "Proposed entry", Actions: StatusChip(p.Proposal.Status)}) {
						@proposalView(*p.Proposal)
					}
				} else {
					@Card(CardProps{ID: "propose", Title: "Proposed entry"}) {
						@EmptyState(EmptyProps{Icon: "file-text", Title: "No entry proposed yet", Body: "A maker can propose a journal entry that would fix this finding."})
						if p.Actions.CanDecide && p.Actions.CreateButton {
							@proposeForm(p)
						}
					}
				}
			</div>
		</div>
		if p.HasTrail {
			@Card(CardProps{ID: "trail", Title: "Investigation trail"}) {
				@Timeline(trailEntries(p.Trail))
			}
		}
		@Card(CardProps{ID: "actions", Title: "Actions"}) {
			if p.Actions.Error != "" {
				<p class="error" role="alert">{ p.Actions.Error }</p>
			}
			if p.Actions.CanDecide {
				<div class="finding-actions">
					if p.Proposal != nil && p.Actions.CreateButton {
						@proposeForm(p)
					}
					<form method="post" action={ templ.SafeURL(findingURL(p.ID) + "/accept") }>
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						@Button(ButtonProps{Label: "Mark accepted", Variant: "secondary", Type: "submit"})
					</form>
					@OpenDialogButton(ButtonProps{Label: "Dismiss", Variant: "danger"}, "dismiss-dialog")
				</div>
				@ConfirmModal(ConfirmProps{
					ID:        "dismiss-dialog",
					Title:     "Dismiss this finding?",
					Body:      dismissBody(p),
					Method:    "post",
					Action:    findingURL(p.ID) + "/dismiss",
					CSRFToken: p.CSRFToken,
					Confirm:   ButtonProps{Label: "Dismiss", Variant: "danger"},
					Extra:     dismissReason(p),
				})
			} else {
				<p>Status: { p.Status }</p>
			}
		}
	}
}

templ backLink(p FindingPage) {
	@Button(ButtonProps{Label: "Back to findings", Variant: "ghost", Size: "sm", Href: findingsURL(p.RunID), Icon: "chevron-right"})
}

templ proposeForm(p FindingPage) {
	<form method="post" action={ templ.SafeURL(proposalsURL(p.ID)) }>
		<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
		@Button(ButtonProps{Label: "Propose entry", Variant: "primary", Type: "submit"})
	</form>
}

templ dismissReason(p FindingPage) {
	@TextareaField(FieldProps{
		ID:       "dismiss-reason",
		Name:     "reason",
		Label:    "Reason",
		Value:    p.Actions.Reason,
		Required: true,
		Attrs:    dismissFieldAttrs(),
	})
}

templ sourceLink(c EvidenceCell) {
	<a href={ templ.SafeURL(c.Link) } rel="noopener noreferrer" target="_blank">{ c.Text }</a>
}

templ evidenceBlock(b EvidenceBlock) {
	<div class="evidence-block">
		<h3>{ b.Heading }</h3>
		<p><code class="args">{ b.Args }</code></p>
		if len(b.IDs) > 0 {
			<p class="ids">ids: { joinIDs(b.IDs) }</p>
		}
		if b.Note != "" {
			<p class="note">{ b.Note }</p>
		}
		if len(b.Rows) > 0 {
			<div class="evidence">
				@DataTable(evidenceTable(b))
			</div>
		}
		if b.More > 0 {
			<p class="note">{ itoa(b.More) } more not shown</p>
		}
	</div>
}

templ proposalView(v ProposalView) {
	<p class="finding-meta">Status: { v.Status } · Maker: { v.Maker } · Posting date: { v.PostingDate }</p>
	<p class="finding-remark">{ v.Remark }</p>
	<div class="ui-table-wrap" tabindex="0" role="region" aria-label="Proposed journal lines">
		<table class="ui-table proposal-lines">
			<thead>
				<tr>
					<th scope="col">Account</th>
					<th scope="col" class="ui-align-right">Debit</th>
					<th scope="col" class="ui-align-right">Credit</th>
				</tr>
			</thead>
			<tbody>
				for _, l := range v.Lines {
					<tr>
						<td>{ l.Account }</td>
						<td class="ui-num ui-align-right">{ l.Debit }</td>
						<td class="ui-num ui-align-right">{ l.Credit }</td>
					</tr>
				}
				<tr class="totals">
					<th scope="row">Total</th>
					<th class="ui-num ui-align-right">{ v.TotalDebit }</th>
					<th class="ui-num ui-align-right">{ v.TotalCredit }</th>
				</tr>
			</tbody>
		</table>
	</div>
	if v.Balanced {
		<p class="balanced finding-balance">Balanced</p>
	} else {
		<p class="error finding-balance" role="alert">Unbalanced: difference { v.Difference }</p>
	}
	if v.ERPName != "" {
		<p>
			Journal entry:
			if v.ERPLink != "" {
				<a href={ templ.SafeURL(v.ERPLink) } rel="noopener noreferrer" target="_blank">{ v.ERPName }</a>
			} else {
				{ v.ERPName }
			}
		</p>
	}
}
