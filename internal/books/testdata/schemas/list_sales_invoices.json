            "collected_via": {
              "description": "account the customer's payment went into (bank or Payment Gateway Clearing); several are joined with '; '; empty while unpaid",
              "type": "string"
            },
            "customer": {
              "description": "Customer name (ID)",
              "type": "string"
            },
            "customer_name": {
              "type": "string"
            },
            "debit_to": {
              "description": "receivable account",
              "type": "string"
            },
            "grand_total": {
              "description": "paise",
              "type": "integer"
            },
            "lines": {
              "description": "item rows",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "account": {
                    "description": "income account",
                    "type": "string"
                  },
                  "amount": {
                    "description": "paise",
                    "type": "integer"
                  },
                  "description": {
                    "type": "string"
                  },
                  "item_code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "account",
                  "amount"
                ],
                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "name": {
              "type": "string"
            },
            "net_total": {
              "description": "total before tax, paise",
