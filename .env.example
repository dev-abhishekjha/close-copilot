# Copy to .env and fill in. The Makefile exports every value to the binaries.
# No quotes around values. .env is git-ignored; never commit real keys.
# Generate a random 32-byte hex value with: openssl rand -hex 32

# --- ERPNext (CC-102, CC-201) -------------------------------------------------
ERP_BASE_URL=http://localhost:8080
# Sent as the Host header so Frappe picks the site
ERP_SITE=erp.localhost
# Keys of the copilot-bot user (Accounts User role; read access for the agent)
ERP_API_KEY=
ERP_API_SECRET=
# The seeder's Administrator keys (ERP_SEED_API_KEY, ERP_SEED_API_SECRET) are
# not set here: deploy/erpnext/api-users.sh writes them to tmp/erp-keys.env
# only. Run seeding in a subshell so they never reach your shell:
#   (set -a; . tmp/erp-keys.env; set +a; <command>)

# --- Postgres (CC-401) --------------------------------------------------------
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable

# --- MCP servers (CC-501, CC-506) ---------------------------------------------
BOOKS_MCP_URL=http://localhost:7001/mcp
EVIDENCE_MCP_URL=http://localhost:7002/mcp
MCP_TOKEN_AGENT=
# Held only by internal/approvals (enforced by the CC-002 analyzer)
MCP_TOKEN_ADMIN=
# Signs run scopes: one company and month per run
MCP_SCOPE_KEY=

# --- LLM (CC-701, CC-710) -----------------------------------------------------
# claude-cli: model calls go through your local `claude -p` (development, no key)
# anthropic:  the API (needs ANTHROPIC_API_KEY); use for the public demo and final baselines
LLM_PROVIDER=claude-cli
CLAUDE_CLI_PATH=claude
ANTHROPIC_API_KEY=
# claude-cli takes aliases (haiku, sonnet); anthropic needs full model IDs,
# e.g. claude-haiku-4-5-20251001 and claude-sonnet-5-5 (check Anthropic's models page)
LLM_MODEL_FAST=haiku
LLM_MODEL_STRONG=sonnet
LLM_DAILY_BUDGET_USD=2.00
# Per close run: the most model tokens (input + output) one run may use;
# over it, the remaining explanations are skipped and the run ends partial
LLM_RUN_TOKEN_CAP=200000
# Pseudonymises GSTINs, PANs and person names before LLM calls
PSEUDONYM_KEY=

# --- Retrieval (CC-802, CC-803) -----------------------------------------------
TEI_EMBED_URL=http://localhost:8081
TEI_RERANK_URL=http://localhost:8082
DOCLING_URL=http://localhost:5001
# TEI image tag for deploy/docker-compose.yml; on Apple Silicon use cpu-arm64-1.9
TEI_IMAGE_TAG=cpu-1.9

# --- Tracing to Langfuse (CC-904) ---------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# Authorization=Basic <base64(public_key:secret_key)>
OTEL_EXPORTER_OTLP_HEADERS=

# --- Web app (CC-1001) --------------------------------------------------------
APP_ADDR=:8000
APP_SESSION_KEY=

# --- Fault injection (CC-705) -------------------------------------------------
# Testing only, never in production: corrupts one explanation on its first
# attempt so the verifier rejects it and the explainer retries.
# COPILOT_FAULT=corrupt_explanation

# --- Seeder and loaders (CC-301, CC-402) --------------------------------------
DATA_DIR=./data/external
