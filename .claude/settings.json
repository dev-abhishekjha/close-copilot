{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go tool *)",
      "Bash(go list *)",
      "Bash(go env *)",
      "Bash(go mod tidy*)",
      "Bash(go mod verify*)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(mkdir -p tmp*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(docker *)",
      "Edit(/evals/golden/**)",
      "Edit(/evals/scenarios/**)",
      "Edit(/evals/baseline.json)",
      "Edit(/gates/**)",
      "Edit(/.github/**)",
      "Edit(/internal/books/admin.go)",
      "Edit(/internal/approvals/**)",
      "Edit(/internal/mcpkit/auth*.go)",
      "Edit(/config/users.yaml)",
      "Edit(/docs/**)",
      "Edit(/CLAUDE.md)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-edit.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/gofmt.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
