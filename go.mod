module github.com/abhishekjha/close-copilot

// The latest releases of OpenTelemetry, golang.org/x/*, templ and goose
// require Go 1.26.
go 1.26.0

toolchain go1.27.2

// Dev tools, run with `go tool <name>` (no global installs needed). goose's
// CLI is run with `go run ...@version` instead (see Makefile) because it
// links every database driver and would bloat this module's requirements.
tool (
	github.com/a-h/templ/cmd/templ
	golang.org/x/vuln/cmd/govulncheck
)

// Initial dependency set from the Implementation Tickets. Versions are the
// latest releases as of 2026-10-06. Run `go mod tidy` once to add the
// indirect requirements and go.sum, then commit both files.
require (
	github.com/a-h/templ v0.3.1070
	github.com/anthropics/anthropic-sdk-go v1.78.0
	github.com/google/uuid v1.6.0
	github.com/jackc/pgx/v5 v5.11.0
	github.com/modelcontextprotocol/go-sdk v1.8.0
	github.com/pgvector/pgvector-go v0.4.1
	github.com/pressly/goose/v3 v3.28.0
	github.com/testcontainers/testcontainers-go v0.44.0
	github.com/testcontainers/testcontainers-go/modules/postgres v0.44.0
	go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp v0.72.0
	go.opentelemetry.io/otel v1.47.0
	go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp v1.47.0
	go.opentelemetry.io/otel/sdk v1.47.0
	go.opentelemetry.io/otel/trace v1.47.0
	go.yaml.in/yaml/v3 v3.0.5
	golang.org/x/crypto v0.57.0
	golang.org/x/time v0.16.0
	golang.org/x/tools v0.51.0
	golang.org/x/vuln v1.8.0 // indirect
)

require golang.org/x/sync v0.23.0

require (
